# Website (Vite) — copy to website/.env  (never commit real .env)
VITE_API_BASE_URL=http://127.0.0.1:8000
# In production, leave VITE_API_BASE_URL unset so the app uses its same-origin
# /api and /uploads rewrites (required for first-party HttpOnly session cookies).
# Set VITE_USE_SAME_ORIGIN_API=false only when intentionally using a remote API
# origin that supports credentialed cross-origin cookies.
# VITE_USE_SAME_ORIGIN_API=true

# Must match a Web client ID in Google Cloud Console
# AND be listed in backend GOOGLE_CLIENT_ID / GOOGLE_CLIENT_IDS
VITE_GOOGLE_CLIENT_ID=470949991659-avk11lvc5sv1ffietga62f8h591t7ijc.apps.googleusercontent.com