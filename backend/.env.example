# Local developer template. Keep real local credentials in backend/.env or
# backend/.env.local (both are git-ignored); do not deploy those files.
# Production values belong in the hosting provider's runtime environment.
# SnapDeploy's managed MySQL add-on supplies MYSQL_URL; the backend supports it.
# Default database = MySQL, database name = novel_app_db_v2
ENV=development
DEBUG=true
DB_TYPE=mysql

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=novel_app_db
MYSQL_SSL_DISABLED=true
MYSQL_INIT_SQL=setup_railway.sql
MYSQL_FALLBACK_SQLITE=false

UPLOAD_DIR=./uploads
JWT_SECRET=change-me-in-production
ADMIN_USERNAME=admin_Supun
ADMIN_PASSWORD=change-me
ADMIN_TOKEN_EXPIRES_HOURS=24
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
# Firebase Admin service-account JSON for the same Firebase project. This is
# separate from Android's google-services.json; keep the private key server-only.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Web cookie auth accepts the production website and local dev by default.
# Add the exact origin of any custom production frontend here.
# WEB_AUTH_ORIGINS=https://novel-v7-web.vercel.app,https://your-site.example

# Startup runs reviewed, additive SQL migrations, schema ensures, and idempotent
# catalog seeds by default. Reset/setup dumps and account/data-rewrite scripts
# are intentionally manual so a restart cannot destroy or rewrite user data.
AUTO_RUN_DB_MIGRATIONS=true
AUTO_RUN_INKITT_SEED=true
# Duplicate cleanup deletes rows; opt in only after backing up the database.
# CLEAN_DUPLICATE_SEED_ROWS_ON_STARTUP=false
# ENABLE_INKITT_SEED=1
# Generated catalog chapters/reviews run automatically on local backend starts.
# Set false to skip locally; set true explicitly to enable on serverless deployments.
# RUN_CONTENT_ENRICHMENT=false
# Schema ensures run at backend startup. Emergency-only opt-out:
# SKIP_STARTUP_SCHEMA_ENSURES=true
